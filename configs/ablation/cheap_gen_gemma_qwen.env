# Ablation: CHEAP GENERATORS + QWEN STRONG PLANNER
# Hypothesis: stronger Qwen sketcher can compensate for cheap open-weight generators.
# Strategy:
# - cheap generators only
# - stronger sketcher (qwen3.6-plus)
# - majority voting (no LLM judge)
# - expanded ensemble budget
# - larger few-shot context

GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3-coder-next
QUERY_SKETCHER_MODEL=qwen/qwen3.6-plus

NUM_CANDIDATES=8
PRIMARY_CALLS=5
SECONDARY_CALLS=3
FEW_SHOT_EXAMPLES_PER_CANDIDATE=20
FEW_SHOT_SEMANTIC_RETRIEVAL=false
