# Ablation: BALANCED LOW-COST PIPELINE
# Goal: keep full Spider dev around ~$15-20 while preserving decent quality.
# Important: this is a balanced cost/quality config, not max-quality and not ultra-cheap.
# Strategy:
# - cheap generators only
# - stronger sketcher to compensate for cheaper generation
# - stronger judge/refiner for better selection/correction
# - reduced but not minimal candidate budget
# - larger few-shot context (10 examples) as requested

GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3.5-35b-a3b
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
JUDGE_MODEL=openai/gpt-4.1

NUM_CANDIDATES=8
PRIMARY_CALLS=5
SECONDARY_CALLS=3
DECOMPOSER_ENABLED=false
MODERATE_NUM_CANDIDATES=2
MODERATE_PRIMARY_CALLS=3
MODERATE_SECONDARY_CALLS=2
FEW_SHOT_EXAMPLES_PER_CANDIDATE=20
FEW_SHOT_SEMANTIC_RETRIEVAL=true
SIMPLE_SKIP_JUDGE_WHEN_VALID=false
