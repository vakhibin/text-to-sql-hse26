# Ablation: BALANCED LOW-COST PIPELINE + MAJORITY VOTING
# Goal: keep full Spider dev around ~$15-20 while preserving decent quality.
# Strategy:
# - cheap generators (gemma + qwen)
# - stronger sketcher (gemini-2.5-pro) to compensate for cheaper generation
# - majority voting instead of LLM judge (zero cost for selection)
# - 8 candidates for robust voting signal
# - large few-shot context (20 examples per candidate)

GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3.5-35b-a3b
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
REFINER_MODEL=google/gemma-4-31b-it

NUM_CANDIDATES=8
PRIMARY_CALLS=5
SECONDARY_CALLS=3
FEW_SHOT_EXAMPLES_PER_CANDIDATE=20
FEW_SHOT_SEMANTIC_RETRIEVAL=true
