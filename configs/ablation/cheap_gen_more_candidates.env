# Ablation: CHEAP GENERATORS + MORE CANDIDATES (compensate quality with quantity)
# Hypothesis: cheap models are noisier, but more candidates + judge can filter
# Sketcher: gemini-2.5-pro | Generators: gemma4 + qwen3-coder | Budget: 8 candidates
# Still cheaper than baseline despite more calls

GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3-coder-next
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
JUDGE_MODEL=openai/gpt-4.1

NUM_CANDIDATES=8
PRIMARY_CALLS=5
SECONDARY_CALLS=3
