# =========================
# OpenRouter
# =========================
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =========================
# Model policy
# =========================
GENERATOR_MODEL_PRIMARY=google/gemini-2.5-pro
GENERATOR_MODEL_SECONDARY=deepseek/deepseek-chat-v3
DECOMPOSER_ENABLED=true
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
JUDGE_MODEL=openai/gpt-4.1
EMBEDDINGS_MODEL=openai/text-embedding-3-large

# =========================
# Data and retrieval
# =========================
SPIDER_ROOT=databases/spider
BIRD_ROOT=databases/bird
BIRD_MINI_ROOT=databases/bird_mini
CHROMA_PERSIST_DIRECTORY=.cache/chroma
CHROMA_COLLECTION_SELECTOR=schema_selector
CHROMA_COLLECTION_FEW_SHOT=few_shot_examples

# =========================
# Ensemble defaults
# =========================
NUM_CANDIDATES=8
PRIMARY_CALLS=5
SECONDARY_CALLS=3
MODERATE_NUM_CANDIDATES=2
MODERATE_PRIMARY_CALLS=2
MODERATE_SECONDARY_CALLS=0
SIMPLE_SKIP_JUDGE_WHEN_VALID=true
FEW_SHOT_SEMANTIC_RETRIEVAL=true
FEW_SHOT_RETRIEVAL_TOP_K=10
FEW_SHOT_SAME_DB_TOP_K=6
FEW_SHOT_RETRIEVAL_WINDOW=6

# =========================
# Selector defaults
# =========================
SELECTOR_TOP_K_TABLES=15
SELECTOR_TARGET_TABLES_MIN=3
SELECTOR_TARGET_TABLES_MAX=5
SELECTOR_TOP_K_LEXICAL_TABLES=8

# =========================
# LLM generation defaults
# =========================
LLM_TEMPERATURE_PRIMARY=0.2
LLM_TEMPERATURE_SECONDARY=0.6
LLM_TEMPERATURE_JUDGE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=90

# =========================
# Retry policy
# =========================
RETRY_ATTEMPTS=3
RETRY_WAIT_MIN_SECONDS=1
RETRY_WAIT_MAX_SECONDS=8

# =========================
# Refiner defaults
# =========================
MAX_REFINE_ATTEMPTS=3

# =========================
# Langfuse (optional)
# =========================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
