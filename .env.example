# =========================
# OpenRouter
# =========================
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =========================
# Model policy
# =========================
# These defaults match the cheapest known full-Spider run
# and use deterministic majority voting instead of an LLM judge.
GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3.5-35b-a3b
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
REFINER_MODEL=google/gemma-4-31b-it
EMBEDDINGS_MODEL=openai/text-embedding-3-large

# =========================
# Data and retrieval
# =========================
SPIDER_ROOT=databases/spider
BIRD_ROOT=databases/bird
BIRD_MINI_ROOT=databases/bird_mini
CHROMA_PERSIST_DIRECTORY=.cache/chroma
CHROMA_COLLECTION_SELECTOR=schema_selector
CHROMA_COLLECTION_FEW_SHOT=few_shot_examples

# =========================
# Ensemble defaults
# =========================
NUM_CANDIDATES=8
PRIMARY_CALLS=5
SECONDARY_CALLS=3
FEW_SHOT_EXAMPLES_PER_CANDIDATE=20
FEW_SHOT_SEMANTIC_RETRIEVAL=true
FEW_SHOT_RETRIEVAL_TOP_K=10
FEW_SHOT_SAME_DB_TOP_K=6
FEW_SHOT_RETRIEVAL_WINDOW=6

# =========================
# Selector defaults
# =========================
SELECTOR_TOP_K_TABLES=15
SELECTOR_TARGET_TABLES_MIN=3
SELECTOR_TARGET_TABLES_MAX=5
SELECTOR_TOP_K_LEXICAL_TABLES=8
# If table count <= this, use full schema (no Chroma/LLM). Set 0 to always filter.
SELECTOR_SKIP_FILTER_MAX_TABLES=10
# How many times sketcher can bounce back to selector when it detects missing entities.
MAX_SKETCHER_SELECTOR_RECOVERY=2

# =========================
# LLM generation defaults
# =========================
LLM_TEMPERATURE_PRIMARY=0.2
LLM_TEMPERATURE_SECONDARY=0.6
LLM_TEMPERATURE_REFINER=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180

# =========================
# Retry policy
# =========================
RETRY_ATTEMPTS=3
RETRY_WAIT_MIN_SECONDS=1
RETRY_WAIT_MAX_SECONDS=8

# =========================
# Refiner defaults
# =========================
MAX_REFINE_ATTEMPTS=3

# =========================
# Langfuse (local stack bundled into docker-compose)
# =========================
# The docker-compose stack ships a self-hosted Langfuse v3 deployment
# (langfuse-web, -worker, -postgres, -clickhouse, -redis, -minio). On first
# `docker compose up` it auto-provisions a dev project via LANGFUSE_INIT_*.
# Browser UI: http://localhost:3000   (login: dev@local.dev / changemechangeme)
#
# These defaults match the in-compose dev project. Rotate before any non-local
# deployment. To disable tracing entirely, set LANGFUSE_ENABLED=false.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-text-to-sql-dev
LANGFUSE_SECRET_KEY=sk-lf-text-to-sql-dev
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_HOST=http://localhost:3000
LANGFUSE_PROJECT_ID=text-to-sql-dev
