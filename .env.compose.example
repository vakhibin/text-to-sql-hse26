# Copy to .env (or export variables in your shell) before running compose.
#
#   cp .env.compose.example .env
#   docker compose up --build

# Required for real LLM calls.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Demo-friendly model policy. Override as needed.
GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3.5-35b-a3b
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
REFINER_MODEL=google/gemma-4-31b-it
JUDGE_MODEL=openai/gpt-4.1
EMBEDDINGS_MODEL=openai/text-embedding-3-large

# Data/cache paths inside the containers. Host paths are mounted by compose:
#   ./databases -> /app/databases
#   ./.cache    -> /app/.cache
SPIDER_ROOT=/app/databases/spider
BIRD_ROOT=/app/databases/bird
BIRD_MINI_ROOT=/app/databases/bird_mini
CHROMA_PERSIST_DIRECTORY=/app/.cache/chroma

# Orchestrator -> text_to_sql_api.
TEXT_TO_SQL_API_URL=http://text-to-sql-api:8001
TEXT_TO_SQL_API_TIMEOUT_S=180
ORCHESTRATOR_MAX_TOOL_STEPS=8
ORCH_SQLITE_PATH=/app/.cache/orchestrator/sessions.sqlite
ORCH_AUDIT_LOG_PATH=/app/.cache/orchestrator/writes.jsonl

# Streamlit -> orchestrator_api (chat) and text_to_sql_api (catalog browser).
ORCHESTRATOR_API_URL=http://orchestrator-api:8002
ORCHESTRATOR_UI_TIMEOUT_S=300
TEXT_TO_SQL_API_URL=http://text-to-sql-api:8001

# --- Langfuse (bundled into compose) ---------------------------------------
# The compose stack ships a self-hosted Langfuse v3 deployment (langfuse-web,
# langfuse-worker, langfuse-postgres, langfuse-clickhouse, langfuse-minio,
# langfuse-redis). The defaults below provision a project on first start via
# LANGFUSE_INIT_*, so text-to-sql-api / orchestrator-api can write traces
# straight after `docker compose up --build`.
#
# Open http://localhost:3000 to view traces (login: dev@local.dev / changemechangeme).
#
# Rotate ALL credentials below before any non-local deployment.

LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-text-to-sql-dev
LANGFUSE_SECRET_KEY=sk-lf-text-to-sql-dev

LANGFUSE_INIT_ORG_ID=text-to-sql
LANGFUSE_INIT_ORG_NAME=text-to-sql
LANGFUSE_INIT_PROJECT_ID=text-to-sql-dev
LANGFUSE_INIT_PROJECT_NAME=text-to-sql-dev
LANGFUSE_INIT_USER_EMAIL=dev@local.dev
LANGFUSE_INIT_USER_NAME=dev
LANGFUSE_INIT_USER_PASSWORD=changemechangeme

# Internal Langfuse infra credentials (local-dev only; rotate for prod).
LANGFUSE_POSTGRES_PASSWORD=postgres
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_MINIO_ROOT_USER=minio
LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_REDIS_AUTH=langfuselocaldev
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=local-dev-nextauth-secret-not-for-prod
LANGFUSE_SALT=local-dev-salt-not-for-prod
# Generate via: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_TELEMETRY_ENABLED=false
