# Copy to .env (or export variables in your shell) before running compose.
#
#   cp .env.compose.example .env
#   docker compose up --build

# Required for real LLM calls.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Demo-friendly model policy. Override as needed.
GENERATOR_MODEL_PRIMARY=google/gemma-4-26b-a4b-it
GENERATOR_MODEL_SECONDARY=qwen/qwen3.5-35b-a3b
QUERY_SKETCHER_MODEL=google/gemini-2.5-pro
REFINER_MODEL=google/gemma-4-31b-it
JUDGE_MODEL=openai/gpt-4.1
EMBEDDINGS_MODEL=openai/text-embedding-3-large

# Data/cache paths inside the containers. Host paths are mounted by compose:
#   ./databases -> /app/databases
#   ./.cache    -> /app/.cache
SPIDER_ROOT=/app/databases/spider
BIRD_ROOT=/app/databases/bird
BIRD_MINI_ROOT=/app/databases/bird_mini
CHROMA_PERSIST_DIRECTORY=/app/.cache/chroma

# Orchestrator -> text_to_sql_api.
TEXT_TO_SQL_API_URL=http://text-to-sql-api:8001
TEXT_TO_SQL_API_TIMEOUT_S=180
ORCHESTRATOR_MAX_TOOL_STEPS=8
ORCH_SQLITE_PATH=/app/.cache/orchestrator/sessions.sqlite

# Streamlit -> orchestrator_api.
ORCHESTRATOR_API_URL=http://orchestrator-api:8002

# Optional tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
